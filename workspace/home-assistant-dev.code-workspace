{
  "folders": [
    {
      "name": "alphaess-wallbox",
      "path": "../../alphaess-wallbox"
    },
    {
      "name": "homeassistant",
      "path": "../../homeassistant"
    },
    {
      "name": "ha-dev-workspace",
      "path": ".."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true
    },
    "python.analysis.extraPaths": [
      "../../alphaess-wallbox/custom_components",
      "../../homeassistant/custom_components"
    ],
    "search.exclude": {
      "**/.git": true,
      "**/__pycache__": true
    },
    "files.associations": {
      "*.yaml": "home-assistant",
      "compose.yml": "yaml",
      "compose.yaml": "yaml",
      "compose.*.yml": "yaml",
      "compose.*.yaml": "yaml",
      "docker-compose.yml": "yaml",
      "docker-compose.yaml": "yaml",
      "docker-compose.*.yml": "yaml",
      "docker-compose.*.yaml": "yaml",
      "esphome/**/*.yml": "esphome",
      "esphome/**/*.yaml": "esphome"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "keesschollaart.vscode-home-assistant",
      "eamodio.gitlens",
      "ms-azuretools.vscode-docker"
    ]
  }
}
